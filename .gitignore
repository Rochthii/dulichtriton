# ==========================================
# DU LỊCH TRI TÔN — GITIGNORE SPECIFICATION
# ==========================================

# 1. Environment & API Keys (TUYỆT ĐỐI BẢO MẬT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert

# 2. Python & Backend Environment
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.log
logs/*.log

# 3. Node.js & Next.js Frontend
node_modules/
.next/
out/
build/
dist/
.vercel
.turbo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. OS & IDE System Files
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
.gemini/

# 5. Temporary & Crawler Outputs
tourism_crawler/__pycache__/
tourism_crawler/export/*.tmp
